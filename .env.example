# Образец настроек. Скопируйте в .env и впишите свои значения:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / VPS:           cp .env.example .env
# Файл .env хранит секреты и НЕ попадает в Git (он указан в .gitignore).

# --- База данных PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=придумайте_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tolstoy

# --- Вход в веб-интерфейс ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте_пароль_для_входа
# Случайная строка для подписи cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=замените_на_случайную_строку

# --- Разбор текстов ---
# stanza — точнее (рекомендуется), natasha — легче и быстрее
NLP_BACKEND=stanza
UPLOAD_MAX_MB=50

# --- Только для VPS (docker compose --profile prod) ---
# DOMAIN=tolstoy.example.ru
# ACME_EMAIL=you@example.ru
# HTTPS_ONLY=1

# --- Старые скрипты из папки legacy/ (если нужны) ---
# DB_NAME_GENERIC=generic
# DB_NAME_NATURAL=natural
