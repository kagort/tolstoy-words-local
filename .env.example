# Образец настроек. Скопируйте в .env и впишите свои значения:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / VPS:           cp .env.example .env
# Файл .env хранит секреты и НЕ попадает в Git (он указан в .gitignore).
# ВАЖНО: не используйте символ $ в значениях — Docker Compose его «съедает».

# --- База данных PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=придумайте_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tolstoy

# --- Вход в веб-интерфейс ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте_пароль_для_входа
# Случайная строка для подписи cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=замените_на_случайную_строку

# --- Разбор текстов ---
# stanza — точнее (рекомендуется), natasha — легче и быстрее
NLP_BACKEND=stanza
UPLOAD_MAX_MB=50
# two_stage (по умолчанию) — весь текст быстро разбирает Natasha, а Stanza — только предложения
# со словами словарей (и всё по кнопке «Точный разбор»); full — всё сразу парсером NLP_BACKEND
# PROCESSING_MODE=two_stage
# после разбора текста извлекать имена собственные (персоны, места, названия); false — только по кнопке
# NER_ON_INGEST=true

# --- Фоновые задачи (можно не трогать) ---
# через сколько минут без «пульса» задача упавшего обработчика возвращается в очередь
# JOB_STALE_MINUTES=5
# после стольких падений обработчика на одной задаче она останавливается с ошибкой
# JOB_MAX_ATTEMPTS=3

# --- Только для VPS (docker compose --profile prod) ---
# DOMAIN=tolstoy.example.ru
# ACME_EMAIL=you@example.ru
# HTTPS_ONLY=1

# --- Старые скрипты из папки legacy/ (если нужны) ---
# DB_NAME_GENERIC=generic
# DB_NAME_NATURAL=natural
