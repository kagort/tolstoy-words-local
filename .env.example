# Образец настроек. Скопируйте в .env и впишите свои значения:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / VPS:           cp .env.example .env
# Файл .env хранит секреты и НЕ попадает в Git (он указан в .gitignore).
# ВАЖНО: не используйте символ $ в значениях — Docker Compose его «съедает».

# --- База данных PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=придумайте_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tolstoy

# --- Вход в веб-интерфейс ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте_пароль_для_входа
# Случайная строка для подписи cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=замените_на_случайную_строку

# --- Тестирование ---
# общий пароль тестировщиков: с ним входят под своим именем (имя видно у загруженных текстов, словарей, отзывов);
# администратор входит как раньше (ADMIN_USERNAME + ADMIN_PASSWORD). Пусто — вход только администратора.
# TESTER_PASSWORD=
# резервные копии базы (контейнер backup): час ежедневной копии и сколько последних копий хранить
# BACKUP_HOUR=3
# BACKUP_KEEP=7
# откуда открывается веб-интерфейс: 127.0.0.1 — только с этого компьютера (по умолчанию);
# 0.0.0.0 — из локальной сети (сервер внутри сети университета: http://IP-сервера:8000)
# WEB_BIND=127.0.0.1
# WEB_PORT=8000

# --- Разбор текстов ---
# stanza — точнее (рекомендуется), natasha — легче и быстрее
NLP_BACKEND=stanza
UPLOAD_MAX_MB=50
# часовой пояс для дат на страницах (Europe/Moscow, Asia/Yekaterinburg, UTC…)
# TIMEZONE=Europe/Moscow
# Интерфейс по умолчанию: v2 — новый (боковое меню, светлая и тёмная тема), classic — прежний.
# Откат для всех: UI_DEFAULT=classic и перезапуск. Каждый пользователь может переключиться сам (ссылка в меню).
# UI_DEFAULT=v2
# two_stage (по умолчанию) — весь текст быстро разбирает Natasha, а Stanza — только предложения
# со словами словарей (и всё по кнопке «Точный разбор»); full — всё сразу парсером NLP_BACKEND
# PROCESSING_MODE=two_stage
# Скорость точного разбора (на результат не влияет; замер — docker compose exec worker python -m app.cli bench-parse):
# потоков PyTorch на обработчик (0 — по ядрам, выделенным контейнеру); при нескольких обработчиках — ядра / их число
# TORCH_THREADS=0
# предложений за один вызов Stanza
# PRECISE_BATCH_SIZE=256
# модели Stanza скачиваются при первом запуске обработчика; если huggingface.co недоступен — зеркало или прокси:
# HF_ENDPOINT=https://hf-mirror.com
# HTTPS_PROXY=http://адрес:порт
# после разбора текста извлекать имена собственные (персоны, места, названия); false — только по кнопке
# NER_ON_INGEST=true

# --- Фоновые задачи (можно не трогать) ---
# через сколько минут без «пульса» задача упавшего обработчика возвращается в очередь
# JOB_STALE_MINUTES=5
# после стольких падений обработчика на одной задаче она останавливается с ошибкой
# JOB_MAX_ATTEMPTS=3

# --- HTTPS (docker compose --profile prod up -d) — docs/DEPLOY.md §2.3а ---
# адрес, по которому открывают сайт: домен, внутреннее имя или IP сервера в сети университета
# DOMAIN=quotverba.pgu.local
# сертификат: internal — свой сертификат Caddy (закрытая сеть; корневой сертификат — поставить на компьютеры);
#   /certs/cert.pem /certs/key.pem — выданный IT-службой (файлы положить в папку certs/ проекта);
#   e-mail — Let's Encrypt (только сервер с выходом в интернет и доменом в DNS)
# TLS=internal
# ACME_EMAIL=you@example.ru
# с HTTPS — обязательно (cookie входа только по HTTPS); веб-интерфейс тогда слушает только 127.0.0.1 (WEB_BIND не задавать)
# HTTPS_ONLY=1

# --- Старые скрипты из папки legacy/ (если нужны) ---
# DB_NAME_GENERIC=generic
# DB_NAME_NATURAL=natural
