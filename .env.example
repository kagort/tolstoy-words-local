# Образец настроек. Скопируйте этот файл в .env и впишите свои значения:
#   Copy-Item .env.example .env
# Файл .env хранит секреты и НЕ попадает в Git (он указан в .gitignore).

# Подключение к PostgreSQL
DB_USER=postgres
DB_PASSWORD=придумайте_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432
DB_NAME_GENERIC=generic
DB_NAME_NATURAL=natural
